InNL,\na.VolumeInNL,\na.UOMofVolumeinNL,\na.ShortDescription,\na.CorporateBrand,\na.RangeBrand,\na.BrandDenomination,\na.BAI,\na.MDRRecordOwner,\na.SalesOrg,\na.DistributionChannel,\na.DeliveringPlant,\na.ProductHierarchy,\na.BaseProduct,\na.RenoInno,\na.LaunchDay,\na.BusinessGroup,\na.Origin,\na.Producer,\na.ChineseDescription,\na.MaterialGroup1,\na.Price,\na.NestecCode,\na.MaterialType,\na.FactorinDSP,\na.DenominatorInNL,\na.ParentCode,\na.MaterialGrp3,\na.MaterialGrp4,\na.SalesUnit,\na.TotalShelfLife,\na.TotalShelfPeriod,\na.TAXClassification,\na.GlobalAttribute3,\na.ProductChannel,\na.REC_CRT_DT,\na.REC_EFF_DT,\na.REC_EXP_DT\nfrom ta1 a\ninner join ta2 b \non left(a.ProductHierarchy,3)=b.L2Code\nwhere XPlantStatus  in ('Z3','Z4','Z2')\n)\n,ta4 as(\nselect \nMaterialNumber,\nMaterialDescription,\nMaterialGroup,\nXPlantStatus,\nLengthInCS,\nWidthInCS,\nHeightInCS,\nVolumeInCS,\nUOMOfVolumeInCS,\nGrossWeightInCS,\nNetWeightInCS,\nFactorInCS,\nUOMofBUN,\nVolumeInBUN,\nUOMofVolumeInBUN ,\nGrossWeightInBUN,\nNetWeightInBUN,\nFactorInNL,\nVolumeInNL,\nUOMofVolumeinNL,\nShortDescription,\nCorporateBrand,\nRangeBrand,\nBrandDenomination,\nBAI,\nMDRRecordOwner,\nSalesOrg,\nDistributionChannel,\nDeliveringPlant,\nProductHierarchy,\nBaseProduct,\nRenoInno,\nLaunchDay,\nBusinessGroup,\nOrigin,\nProducer,\nChineseDescription,\nMaterialGroup1,\nPrice,\nNestecCode,\nMaterialType,\nFactorinDSP,\nDenominatorInNL,\nParentCode,\nMaterialGrp3,\nMaterialGrp4,\nSalesUnit,\nTotalShelfLife,\nTotalShelfPeriod,\nTAXClassification,\nGlobalAttribute3,\nProductChannel,\nREC_CRT_DT,\nREC_EFF_DT,\nREC_EXP_DT\nfrom ta3 \n)\n,\nta5 as(\nselect \na.MaterialNumber,\na.MaterialDescription,\na.MaterialGroup,\na.XPlantStatus,\na.LengthInCS,\na.WidthInCS,\na.HeightInCS,\na.VolumeInCS,\na.UOMOfVolumeInCS,\na.GrossWeightInCS,\na.NetWeightInCS,\na.FactorInCS,\na.UOMofBUN,\na.VolumeInBUN,\na.UOMofVolumeInBUN ,\na.GrossWeightInBUN,\na.NetWeightInBUN,\na.FactorInNL,\na.VolumeInNL,\na.UOMofVolumeinNL,\na.ShortDescription,\na.CorporateBrand,\na.RangeBrand,\na.BrandDenomination,\na.BAI,\na.MDRRecordOwner,\na.SalesOrg,\na.DistributionChannel,\na.DeliveringPlant,\na.ProductHierarchy,\na.BaseProduct,\na.RenoInno,\na.LaunchDay,\na.BusinessGroup,\na.Origin,\na.Producer,\na.ChineseDescription,\na.MaterialGroup1,\na.Price,\na.NestecCode,\na.MaterialType,\na.FactorinDSP,\na.DenominatorInNL,\na.ParentCode,\na.MaterialGrp3,\na.MaterialGrp4,\na.SalesUnit,\na.TotalShelfLife,\na.TotalShelfPeriod,\na.TAXClassification,\na.GlobalAttribute3,\na.ProductChannel,\na.REC_CRT_DT,\na.REC_EFF_DT,\na.REC_EXP_DT\nfrom ta1 a \nleft join ta2 b \non left(a.ProductHierarchy,3)=b.L2Code\nwhere b.L2Code is null\n)\n,\nta6 as(\nselect \nMaterialNumber,\nMaterialDescription,\nMaterialGroup,\nXPlantStatus,\nLengthInCS,\nWidthInCS,\nHeightInCS,\nVolumeInCS,\nUOMOfVolumeInCS,\nGrossWeightInCS,\nNetWeightInCS,\nFactorInCS,\nUOMofBUN,\nVolumeInBUN,\nUOMofVolumeInBUN ,\nGrossWeightInBUN,\nNetWeightInBUN,\nFactorInNL,\nVolumeInNL,\nUOMofVolumeinNL,\nShortDescription,\nCorporateBrand,\nRangeBrand,\nBrandDenomination,\nBAI,\nMDRRecordOwner,\nSalesOrg,\nDistributionChannel,\nDeliveringPlant,\nProductHierarchy,\nBaseProduct,\nRenoInno,\nLaunchDay,\nBusinessGroup,\nOrigin,\nProducer,\nChineseDescription,\nMaterialGroup1,\nPrice,\nNestecCode,\nMaterialType,\nFactorinDSP,\nDenominatorInNL,\nParentCode,\nMaterialGrp3,\nMaterialGrp4,\nSalesUnit,\nTotalShelfLife,\nTotalShelfPeriod,\nTAXClassification,\nGlobalAttribute3,\nProductChannel,\nREC_CRT_DT,\nREC_EFF_DT,\nREC_EXP_DT\nfrom ta5\n)\nselect \n'Num' as Num,\n'MaterialNumber' as  MaterialNumber,\n'MaterialDescription' as  MaterialDescription,\n'MaterialGroup' as  MaterialGroup,\n'XPlantStatus' as  XPlantStatus,\n'LengthInCS' as  LengthInCS,\n'WidthInCS' as  WidthInCS,\n'HeightInCS' as  HeightInCS,\n'VolumeInCS' as  VolumeInCS,\n'UOMOfVolumeInCS' as  UOMOfVolumeInCS,\n'GrossWeightInCS' as  GrossWeightInCS,\n'NetWeightInCS' as  NetWeightInCS,\n'FactorInCS' as  FactorInCS,\n'UOMofBUN' as  UOMofBUN,\n'VolumeInBUN' as  VolumeInBUN,\n'UOMofVolumeInBUN' as  UOMofVolumeInBUN,\n'GrossWeightInBUN' as  GrossWeightInBUN,\n'NetWeightInBUN' as  NetWeightInBUN,\n'FactorInNL' as  FactorInNL,\n'VolumeInNL' as  VolumeInNL,\n'UOMofVolumeinNL' as  UOMofVolumeinNL,\n'ShortDescription' as  ShortDescription,\n'CorporateBrand' as  CorporateBrand,\n'RangeBrand' as  RangeBrand,\n'BrandDenomination' as  BrandDenomination,\n'BAI' as  BAI,\n'MDRRecordOwner' as  MDRRecordOwner,\n'SalesOrg' as  SalesOrg,\n'DistributionChannel' as  DistributionChannel,\n'DeliveringPlant' as  DeliveringPlant,\n'ProductHierarchy' as  ProductHierarchy,\n'BaseProduct' as  BaseProduct,\n'RenoInno' as  RenoInno,\n'LaunchDay' as  LaunchDay,\n'BusinessGroup' as  BusinessGroup,\n'Origin' as  Origin,\n'Producer' as  Producer,\n'ChineseDescription' as  ChineseDescription,\n'MaterialGroup1' as MaterialGroup1 ,\n'Price' as Price,\n'NestecCode' as  NestecCode,\n'MaterialType' as  MaterialType,\n'FactorinDSP' as  FactorinDSP,\n'DenominatorInNL' as  DenominatorInNL,\n'ParentCode' as  ParentCode,\n'MaterialGrp3' as  MaterialGrp3,\n'MaterialGrp4' as  MaterialGrp4,\n'SalesUnit' as  SalesUnit,\n'TotalShelfLife' as  TotalShelfLife,\n'TotalShelfPeriod' as  TotalShelfPeriod,\n'TAXClassification' as TAXClassification ,\n'GlobalAttribute3' as  GlobalAttribute3,\n'ProductChannel' as  ProductChannel,\n'REC_CRT_DT' as  REC_CRT_DT,\n'REC_EFF_DT' as  REC_EFF_DT,\n'REC_EXP_DT' as  REC_EXP_DT\nunion all\nselect \nstr(Num) as Num,\nMaterialNumber,\nMaterialDescription,\nMaterialGroup,\nXPlantStatus,\nLengthInCS,\nWidthInCS,\nHeightInCS,\nVolumeInCS,\nUOMOfVolumeInCS,\nGrossWeightInCS,\nNetWeightInCS,\nFactorInCS,\nUOMofBUN,\nVolumeInBUN,\nUOMofVolumeInBUN ,\nGrossWeightInBUN,\nNetWeightInBUN,\nFactorInNL,\nVolumeInNL,\nUOMofVolumeinNL,\nShortDescription,\nCorporateBrand,\nRangeBrand,\nBrandDenomination,\nBAI,\nMDRRecordOwner,\nSalesOrg,\nDistributionChannel,\nDeliveringPlant,\nProductHierarchy,\nBaseProduct,\nRenoInno,\nLaunchDay,\nBusinessGroup,\nOrigin,\nProducer,\nChineseDescription,\nMaterialGroup1,\nPrice,\nNestecCode,\nMaterialType,\nFactorinDSP,\nDenominatorInNL,\nParentCode,\nMaterialGrp3,\nMaterialGrp4,\nSalesUnit,\nTotalShelfLife,\nTotalShelfPeriod,\nTAXClassification,\nGlobalAttribute3,\nProductChannel,\nREC_CRT_DT,\nREC_EFF_DT,\nREC_EXP_DT\nfrom (\nselect \nrow_number() over(order by MaterialNumber ) as Num,\nMaterialNumber,\nMaterialDescription,\nMaterialGroup,\nXPlantStatus,\nLengthInCS,\nWidthInCS,\nHeightInCS,\nVolumeInCS,\nUOMOfVolumeInCS,\nGrossWeightInCS,\nNetWeightInCS,\nFactorInCS,\nUOMofBUN,\nVolumeInBUN,\nUOMofVolumeInBUN ,\nGrossWeightInBUN,\nNetWeightInBUN,\nFactorInNL,\nVolumeInNL,\nUOMofVolumeinNL,\nShortDescription,\nCorporateBrand,\nRangeBrand,\nBrandDenomination,\nBAI,\nMDRRecordOwner,\nSalesOrg,\nDistributionChannel,\nDeliveringPlant,\nProductHierarchy,\nBaseProduct,\nRenoInno,\nLaunchDay,\nBusinessGroup,\nOrigin,\nProducer,\nChineseDescription,\nMaterialGroup1,\nPrice,\nNestecCode,\nMaterialType,\nFactorinDSP,\nDenominatorInNL,\nParentCode,\nMaterialGrp3,\nMaterialGrp4,\nSalesUnit,\nTotalShelfLife,\nTotalShelfPeriod,\nTAXClassification,\nGlobalAttribute3,\nProductChannel,\nREC_CRT_DT,\nREC_EFF_DT,\nREC_EXP_DT\nfrom (\nselect \nMaterialNumber,\nMaterialDescription,\nMaterialGroup,\nXPlantStatus,\nLengthInCS,\nWidthInCS,\nHeightInCS,\nVolumeInCS,\nUOMOfVolumeInCS,\nGrossWeightInCS,\nNetWeightInCS,\nFactorInCS,\nUOMofBUN,\nVolumeInBUN,\nUOMofVolumeInBUN ,\nGrossWeightInBUN,\nNetWeightInBUN,\nFactorInNL,\nVolumeInNL,\nUOMofVolumeinNL,\nShortDescription,\nCorporateBrand,\nRangeBrand,\nBrandDenomination,\nBAI,\nMDRRecordOwner,\nSalesOrg,\nDistributionChannel,\nDeliveringPlant,\nProductHierarchy,\nBaseProduct,\nRenoInno,\nLaunchDay,\nBusinessGroup,\nOrigin,\nProducer,\nChineseDescription,\nMaterialGroup1,\nPrice,\nNestecCode,\nMaterialType,\nFactorinDSP,\nDenominatorInNL,\nParentCode,\nMaterialGrp3,\nMaterialGrp4,\nSalesUnit,\nTotalShelfLife,\nTotalShelfPeriod,\nTAXClassification,\nGlobalAttribute3,\nProductChannel,\nREC_CRT_DT,\nREC_EFF_DT,\nREC_EXP_DT\nfrom ta3 \nunion all\nselect \nMaterialNumber,\nMaterialDescription,\nMaterialGroup,\nXPlantStatus,\nLengthInCS,\nWidthInCS,\nHeightInCS,\nVolumeInCS,\nUOMOfVolumeInCS,\nGrossWeightInCS,\nNetWeightInCS,\nFactorInCS,\nUOMofBUN,\nVolumeInBUN,\nUOMofVolumeInBUN ,\nGrossWeightInBUN,\nNetWeightInBUN,\nFactorInNL,\nVolumeInNL,\nUOMofVolumeinNL,\nShortDescription,\nCorporateBrand,\nRangeBrand,\nBrandDenomination,\nBAI,\nMDRRecordOwner,\nSalesOrg,\nDistributionChannel,\nDeliveringPlant,\nProductHierarchy,\nBaseProduct,\nRenoInno,\nLaunchDay,\nBusinessGroup,\nOrigin,\nProducer,\nChineseDescription,\nMaterialGroup1,\nPrice,\nNestecCode,\nMaterialType,\nFactorinDSP,\nDenominatorInNL,\nParentCode,\nMaterialGrp3,\nMaterialGrp4,\nSalesUnit,\nTotalShelfLife,\nTotalShelfPeriod,\nTAXClassification,\nGlobalAttribute3,\nProductChannel,\nREC_CRT_DT,\nREC_EFF_DT,\nREC_EXP_DT\nfrom ta6\n)t \n)a",
