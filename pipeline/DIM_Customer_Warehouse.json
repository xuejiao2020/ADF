				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\nT1.WHS_UNIID,\nT1.WHS_CD,\nT1.WHS_NM,\nNULL [1],\nT1.WHS_DTR_CD,\nT1.WHS_DTR_NM,\nT1.NTS_REG_CD,\nT1.NTS_REG_DES,\nT1.WHS_POV_CD,\nT1.WHS_POV_DES,\nT1.WHS_CTG_CD,\nT1.WHS_CTG_M_DES,\nT1.WHS_CTG_M_DES_E,\nT1.WHS_CTY_CD,\nT1.WHS_CTY_DES,\nNULL [2],\nNULL [3],\nT1.WHS_DEF_REG_DES,\nT1.WHS_DEF_REG,\nT1.WHS_SCD,\nT1.WHS_SNM,\nT1.WHS_TYP_CD,\nT1.WHS_TYP_DES,\ncase when T1.WHS_TYP_CD in ('0','n','nn','z','xz') then 1 \nwhen T1.WHS_TYP_CD in ('1','2','c','xc') then 2\nelse 0 end [4],\ncase when T1.WHS_TYP_CD in ('0','n','nn','z','xz') then N'门店仓库'\nwhen T1.WHS_TYP_CD in ('1','2','c','xc') then N'客户大仓'\nelse N'其他' end [5],\nCASE \nWHEN  WHS_DTR_CD='1000000LEYYOUGROUP' then\n(CASE WHEN\nT1.WHS_TYP_CD in ('n')\nthen 'TRUE' ELSE 'FALSE' END)\nWHEN  WHS_DTR_CD='1000000KIDSWANTGROUP' then\n'FALSE'\nELSE 'FALSE' END as Is_Franchise,\nCASE \nWHEN  WHS_DTR_CD='1000000LEYYOUGROUP' then\n(CASE WHEN\nT2.STR_TYP_ID in ('v','DSCCSDMV')\nthen 'TRUE' ELSE 'FALSE' END)\nWHEN  WHS_DTR_CD='1000000KIDSWANTGROUP' then\n'FALSE'\nELSE 'FALSE' END as Is_Virtual,\n\nCase when T1.WHS_INA_FLG='Y' THEN 'TRUE' ELSE 'FALSE' END [6],\nT1.WHS_STA_DT,\nT1.WHS_END_DT,\ndateadd(hh,8, GETDATE()) [7] FROM  [MVIEW].MDM_WHS_MST_MV T1\nLEFT JOIN [MVIEW].MDM_STR_MST_MV T2 ON T2.STR_DTR_CD = T1.WHS_DTR_CD and T1.WHS_CD = T2.STR_SCD \nand T2.STR_INA_FLG!='Y'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false
				},
