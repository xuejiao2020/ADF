						"preCopyScript": "delete [NESZ_AL].[KPI_FG_StockCover] WHERE date>=CONVERT(varchar(100),dateadd(wk, DATEDIFF(wk,0,getdate()), 0), 112)\nand date<=CONVERT(varchar(100),dateadd(wk,datediff(wk,0,getdate()),6), 112)",
						"writeBehavior": "insert",
						"tableOption": "autoCreate",
						"disableMetricsCollection": false
					},
