				"typeProperties": {
					"source": {
						"type": "HiveSource",
						"query": "SELECT\n  UUID,\n  Company_Cd,\n  Company_NmEn,\n  Company_NmCn,\n  Plant_UniId,\n  Factory_Cd,\n  Factory_NmEn,\n  Factory_NmCn,\n  BU_Cd,\n  BU_NmCn,\n  BU_NmEn,\n  PrdHieLev1_Cd,\n  PrdHieLev1_Nm,\n  PrdHieLev2_Cd,\n  PrdHieLev2_Nm,\n  Product_MG1_Cd,\n  Product_MG1_NmEn,\n  Product_MG1_NmCn,\n  Product_UniId,\n  Product_Cd,\n  Product_NmEn,\n  Product_NmCn,\n  Demand_Amt,\n  Closing_Stock_Amt,\n  StockCover_Day_ByAmt,\n  Currency,\n  Demand_Qty,\n  Closing_Stock_Qty,\n  StockCover_Day_ByQty,\n  Qty_Unit,\n  Is_Summary,\n  Summary_Level,\n  DrillDown_Path,\n  Version_Week,\n  Data_Year,\n  Data_Week,\n  `date`,\n  Etl_Tm,\n  Etl_Src,\n  Etl_Job\nFROM dscc.Wave2_KPI_FG_StockCover\nWHERE `date`>=date_format(date_sub(next_day(CURRENT_DATE,'MO'),7),'yyyyMMdd')\nand `date`<=date_format(date_add(date_sub(next_day(CURRENT_DATE,'MO'),7),6),'yyyyMMdd')"
