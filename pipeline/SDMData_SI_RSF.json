				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "WITH maxdt as(\n  select *\n  from dbo.RSF\n  where sorperiod = FORMAT(GetDate(),'yyyyMM')\n),\nsorperiod_dt as(\n  SELECT sorperiod,RSF_Source,PubDate\n  FROM\n    (SELECT sorperiod,RSF_Source,PubDate,row_number() over (partition by sorperiod,RSF_Source order by PubDate desc)sorperiod_rank\n    FROM maxdt)tmp\n    --dscc.DW2SAP_RSF_L1)tmp\n  WHERE sorperiod_rank=1\n)\nselect sum(Amount) from maxdt  t1 inner join sorperiod_dt t2 \non\nt1.sorperiod=t2.sorperiod AND t1.PubDate=t2.PubDate \n AND t1.RSF_Source=t2.RSF_Source ",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
