							"value": "delete [NESZ_AL].[KPI_RP_OOS] \nWHERE date>= convert(varchar(10),dateadd(dd,-(DatePart(weekday, dateadd(dd,-1,getdate()))-1),getdate()),112) \nand date<= convert(varchar(10),dateadd(dd,(7-DatePart(weekday, dateadd(dd,-1,getdate()))),getdate()),112)",
