				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT \nT1.STR_UNIID,\nT1.STR_NO,\nT1.STR_NAM,\nT1.STR_TYP_ID,\nT1.STR_TYP,\nCASE \nWHEN  STR_DTR_CD='1000000LEYYOUGROUP' then\n(CASE WHEN\nT1.STR_TYP_ID='n' or (T1.STR_TYP_ID='v' and T4.WHS_TYP_CD='n') \nthen 'TRUE' ELSE 'FALSE' END)\nWHEN  STR_DTR_CD='1000000KIDSWANTGROUP' then\n'FALSE'\nELSE 'FALSE' END,\nCASE \nWHEN  STR_DTR_CD='1000000LEYYOUGROUP' then\n(CASE WHEN\nT1.STR_TYP_ID in ('v','DSCCSDMV')\nthen 'TRUE' ELSE 'FALSE' END)\nWHEN  STR_DTR_CD='1000000KIDSWANTGROUP' then\n'FALSE'\nELSE 'FALSE' END,\nNULL,\nT1.STR_DTR_CD,\nT1.STR_DTR_NM,\nT1.NTS_REG_CD,\nT1.NTS_REG_DES,\nT1.STR_POV_CD,\nT1.STR_POV_DES,\nT1.STR_CTG_CD,\nT1.STR_CTG_M_DES_C,\nT1.STR_CTG_M_DES_E,\nT1.STR_CTY_CD,\nT1.STR_CTY_DES,\nNULL,\nNULL,\nISNULL(T1.STR_DEF_REG_DES,'undefined'),\nISNULL(T1.STR_DEF_REG,'undefined'),\nT4.WHS_UNIID,\nT1.STR_SCD,\nT1.STR_SNM,\ncase when T1.STR_XZ = 'Y' then 'TRUE' else 'FALSE' end,\nT1.STR_ACT,\nCase when T1.STR_INA_FLG='Y' then 'TRUE' else 'FALSE' END,\nT1.STR_STA_DT,\nT1.STR_END_DT,\nDATEADD(hh,8,getdate())\nFROM \n[MVIEW].MDM_STR_MST_MV  T1\nLEFT JOIN [MVIEW].MDM_WHS_MST_MV T4 ON T1.STR_DTR_CD = T4.WHS_DTR_CD and T4.WHS_CD = T1.STR_SCD and \nT4.WHS_INA_FLG!='Y'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false
				},
