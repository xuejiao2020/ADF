						"q": {
							"value": "declare @nowDate datetime = dateadd(HH,8,GETDATE());\ndeclare @nowYW  int = cast( concat( convert(char(4),dateadd(WEEK,-3,@nowDate),112), right('0'+ltrim(datename(week,dateadd(WEEK,-3,@nowDate))),2) ) as int);\ndeclare @lastYW int = cast( concat( convert(char(4),dateadd(WEEK,-17,@nowDate),112), right('0'+ltrim(datename(week,dateadd(WEEK,-17,@nowDate))),2) ) as int);\n\ndelete NESZ_AL.KPI_SI_DPA_DPB_DC_W where Data_YW >= @lastYW and Data_YW <= @nowYW\n",
							"type": "String"
						}
