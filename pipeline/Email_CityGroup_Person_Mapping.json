					"source": {
						"type": "HiveSource",
						"query": "with max_table as  (\n     select MDM_Rawdata_Id,max(MDM_Rawdata_updatetime) as MDM_Rawdata_updatetime from dscc.Email_CityGroup_Person_Mapping_L2 group by MDM_Rawdata_Id\n),Data_table as (\n   SELECT T1.* FROM dscc.Email_CityGroup_Person_Mapping_L2 T1 \n   INNER JOIN max_table T2 ON T1.MDM_Rawdata_Id=T2.MDM_Rawdata_Id AND T1.MDM_Rawdata_updatetime=T2.MDM_Rawdata_updatetime\n   where T1.MDM_Rawdata_AcStatus!='D'\n)\n\nselect * from Data_table"
