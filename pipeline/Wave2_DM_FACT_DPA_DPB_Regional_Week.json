				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "sp_executesql",
					"storedProcedureParameters": {
						"q": {
							"value": "declare @nowDate datetime = dateadd(HH,8,GETDATE());\ndeclare @nowYW  int = cast( concat( convert(char(4),dateadd(WEEK,-3,@nowDate),112), right('0'+ltrim(datename(week,dateadd(WEEK,-3,@nowDate))),2) ) as int);\ndeclare @lastYW int = cast( concat( convert(char(4),dateadd(WEEK,-17,@nowDate),112), right('0'+ltrim(datename(week,dateadd(WEEK,-17,@nowDate))),2) ) as int);\n\ndelete DSCC_NESZ.DM_FACT_DPA_DPB_Regional_Week where cast(concat(DataYear,DataWeek) as int) >= @lastYW and cast(concat(DataYear,DataWeek) as int) <= @nowYW",
							"type": "String"
						}
					}
				},
